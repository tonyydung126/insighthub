    {"id": 2, "type": "graph", "title": "RAG Query Latency p99", "targets": [{"expr": "histogram_quantile(0.99, sum(rate(insighthub_rag_query_latency_seconds_bucket[5m])) by (le))"}]},
    {"id": 3, "type": "graph", "title": "LLM Call Latency p95", "targets": [{"expr": "histogram_quantile(0.95, sum(rate(insighthub_llm_call_latency_seconds_bucket[5m])) by (le))"}]},
    {"id": 4, "type": "graph", "title": "LLM Call Latency Upper Band", "targets": [{"expr": "insighthub_llm_call_latency_seconds_upper_band"}]},
    {"id": 5, "type": "graph", "title": "Ingestion Queue Depth", "targets": [{"expr": "insighthub_ingestion_queue_depth"}]},
    {"id": 6, "type": "graph", "title": "Ingestion Documents Pending", "targets": [{"expr": "insighthub_documents_total{status=\"pending\"}"}]},
    {"id": 7, "type": "graph", "title": "Ingestion Documents Ready", "targets": [{"expr": "insighthub_documents_total{status=\"ready\"}"}]},
    {"id": 8, "type": "graph", "title": "Ingestion Errors Total", "targets": [{"expr": "rate(insighthub_ingestion_errors_total[5m])"}]},
    {"id": 9, "type": "graph", "title": "LLM Tokens Output", "targets": [{"expr": "rate(insighthub_llm_tokens_total{direction=\"output\"}[5m])"}]}
